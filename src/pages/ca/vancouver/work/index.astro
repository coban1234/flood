---
import MarketLayout from "../../../../layouts/MarketLayout.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import { SITE_ORIGIN, vancouver } from "../../../../data/site";
import { launchJobs } from "../../../../data/jobs";

const path = `${vancouver.path}/work/`;
---

<MarketLayout
  title="Documented Water Damage Jobs Metro Vancouver | Tidemark"
  description="Three documented losses at launch: residential, multi-unit, and commercial. Readings, not mood lighting."
  path={path}
>
  <main id="main">
    <div class="wrap">
      <Breadcrumbs
        crumbs={[
          { name: "Tidemark", href: `${SITE_ORIGIN}${vancouver.path}/` },
          { name: "Metro Vancouver", href: `${SITE_ORIGIN}${vancouver.path}/` },
          { name: "Work" },
        ]}
      />
    </div>
    <section class="hero">
      <div class="wrap">
        <p class="eyebrow">Anonymised to neighbourhood</p>
        <h1 class="display">Documented jobs</h1>
        <div class="tiles">
          {
            launchJobs.map((j) => (
              <a class="tile" href={`${path}${j.slug}/`}>
                <div class="tile__photo"></div>
                <div class="tile__label">{j.title}</div>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</MarketLayout>
