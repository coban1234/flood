---
import Base from "../layouts/Base.astro";
import { SITE_ORIGIN, vancouver, newYork } from "../data/site";
---

<Base
  title="Tidemark Restoration — 24/7 water damage response"
  description="24/7 water damage restoration. Choose Metro Vancouver or New York."
  canonical={`${SITE_ORIGIN}/`}
  lang="en"
>
  <main id="main" style="min-height:100svh;display:grid;place-items:center;padding:2rem">
    <div style="width:min(28rem,100%)">
      <p class="eyebrow">Tidemark Restoration</p>
      <h1 class="display">24/7 water damage response</h1>
      <p class="lede">Looks like you're near Vancouver. Choose a market — we will not force a redirect.</p>
      <div class="stack">
        <a class="btn btn--call" href={`${vancouver.path}/`} style="width:100%">Vancouver & Fraser Valley →</a>
        <a class="btn btn--ghost" href={`${newYork.path}/`} style="width:100%">New York →</a>
      </div>
    </div>
  </main>
</Base>
