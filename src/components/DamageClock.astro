---
import { clockBands } from "../data/mechanics";
---

<section class="section" aria-labelledby="clock-h">
  <div class="wrap">
    <p class="eyebrow">How long has it been wet?</p>
    <h2 id="clock-h" class="display">The damage clock</h2>
    {/* Claims below are IICRC S500-shaped and still need technician sign-off before launch. */}
    <p class="lede">
      These bands are what water does to a building as the hours pass, shaped by IICRC S500 guidance
      and the jobs we run. Not a countdown — the hour a given material turns depends on how much
      water there was, how warm the room is, and what the water was carrying. Use it to work out
      which job you have, then call whichever band you are in.
    </p>
    <div class="clock">
      {
        clockBands.map((b) => (
          <article class="panel" id={`clock-${b.id}`}>
            <p class="eyebrow">{b.range}</p>
            <h3>{b.label}</h3>
            <p>{b.body}</p>
            {b.salvageable.length > 0 && (
              <p>
                <strong>Still salvageable:</strong> {b.salvageable.join(" · ")}
              </p>
            )}
            {b.risk.length > 0 && (
              <p>
                <strong>At risk:</strong> {b.risk.join(" · ")}
              </p>
            )}
            {b.lost.length > 0 && (
              <p>
                <strong>Typically lost:</strong> {b.lost.join(" · ")}
              </p>
            )}
            <p>Water category: {b.category}</p>
            <p>{b.close}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
