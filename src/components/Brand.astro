---
import { brand, vancouver } from "../data/site";

interface Props {
  href?: string;
}
const href = Astro.props.href ?? `${vancouver.path}/`;
---

<a class="brand" href={href} aria-label={`${brand.name} home`}>
  <img src="/logo-dark.svg" width="28" height="28" alt="" />
  <span>{brand.shortName}</span>
</a>
