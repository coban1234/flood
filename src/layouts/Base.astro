---
interface Props {
  title: string;
  description: string;
  canonical: string;
  lang?: string;
  jsonLd?: unknown[];
  noindex?: boolean;
  systemFonts?: boolean;
  alternates?: { lang: string; href: string }[];
}

const {
  title,
  description,
  canonical,
  lang = "en-CA",
  jsonLd = [],
  noindex = false,
  systemFonts = false,
  alternates = [],
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,400;0,500;0,600;0,700&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />
    {jsonLd.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
    <meta name="theme-color" content={systemFonts ? "#161A1F" : "#E23A12"} />
    <slot name="head" />
  </head>
  <body class={systemFonts ? "is-emergency" : undefined}>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
  .is-emergency {
    background: #161a1f;
    color: #f4f1ea;
  }
  .is-emergency .banner {
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
  }
</style>
